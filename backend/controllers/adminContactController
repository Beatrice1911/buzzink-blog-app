const ContactMessage = require("../models/ContactMessage");

const getContactMessages = async (req, res, next) => {
  try {
    const page = Math.max(parseInt(req.query.page) || 1, 1);
    const limit = Math.max(parseInt(req.query.limit) || 8, 1);
    const skip = (page - 1) * limit;

    const [messages, total] = await Promise.all([
      ContactMessage.find().sort({ createdAt: -1 }).skip(skip).limit(limit),
      ContactMessage.countDocuments(),
    ]);

    res.json({
      data: messages,
      page,
      pages: Math.ceil(total / limit),
      total,
    });
  } catch (err) {
    next(err);
  }
};

const markAsReadContactMessage = async (req, res, next) => {
  try {
    await ContactMessage.findByIdAndUpdate(req.params.id, {
      isRead: true,
    });

    res.json({ message: "Marked as read" });
  } catch (err) {
    next(err);
  }
};

const markAllAsReadContactMessages = async (req, res, next) => {
  await ContactMessage.updateMany(
    { isRead: false },
    { $set: { isRead: true } }
  );

  res.json({ message: "All messages marked as read" });
}

const deleteContactMessage = async (req, res, next) => {
  const { id } = req.params;

  const message = await ContactMessage.findById(id);
  if (!message) {
    return res.status(404).json({ message: "Message not found" });
  }

  await message.deleteOne();

  res.json({ message: "Message deleted" });
};

module.exports = {
  getContactMessages,
  markAsReadContactMessage,
  markAllAsReadContactMessages,
  deleteContactMessage,
};
